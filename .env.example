# ==============================================================================
# AS AUTO DREAMS — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env (desenvolvimento local) e configure na Vercel.
# NUNCA envie arquivos .env com chaves reais para o GitHub.
# ==============================================================================

# URL pública do projeto Supabase (encontrada em Settings -> API)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública anônima (anon/public key) do Supabase
# Esta chave é segura para o navegador quando o RLS (Row Level Security) está ativo.
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-do-supabase"

# URL onde o aplicativo está hospedado (opcional, preenchida automaticamente na Vercel/AI Studio)
APP_URL="http://localhost:3000"

# Apenas para modo de pré-visualização local sem Supabase configurado (opcional)
PREVIEW_ADMIN_EMAIL="admin@asautodreams.com.br"
PREVIEW_ADMIN_PASSWORD=""
